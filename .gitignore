# ==========================================
# DIGIVAULT - Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment variables & secrets
.env
.env.*
*.env
!.env.example
!*.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Production build outputs
dist/
*/dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Uploaded documents (keep directory structure and bundled sample files)
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/sample_*
!server/uploads/simulated_file.pdf

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data & PID files
pids/
*.pid
*.seed
*.pid.lock

# Test coverage & reports
coverage/
.nyc_output/
*.lcov
cypress/videos/
cypress/screenshots/
.playwright/

# Editor & IDE configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
[Dd]esktop.ini
$RECYCLE.BIN/

# Temporary & Cache files
tmp/
temp/
.cache/
.eslintcache
.parcel-cache
